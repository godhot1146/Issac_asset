<?xml version="1.0"?>
<robot name="pallet">
 
    <link name="base_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="urdf/pallet/pallet.dae" scale="1.0 1.0 1.0"/>
            </geometry>
 
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
            <mesh filename="urdf/pallet/pallet.dae" scale="1.0 1.0 1.0"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="15.0"/>
            <inertia ixx="1.5406" ixy="0.0" ixz="0.0" iyy="1.5406" iyz="0.0" izz="1.025"/>
        </inertial>

 </link>
 
</robot>