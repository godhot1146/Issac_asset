<?xml version="1.0"?>
<!--
  robot_stand.urdf
  두산 A0509 장착용 스탠드/캐비닛.
  - 전체 높이 800mm (상단면 z=0.8) → 로봇 베이스를 z=0.8에 올려 장착
  - 하단은 개방 공간(제어기 / 컴프레셔 / 미니PC 수납) — 앞면(-y)은 접근용으로 개방
  - 프리미티브 박스로 구성(메쉬 불필요). 구조물이므로 사용 시 fix_base_link=True 권장

  치수(m): 발자국 0.6(x) x 0.6(y), 높이 0.8
    상판/바닥판 두께 0.02, 기둥 Ø30mm 원기둥(반지름 0.015), 패널 0.015
    내부 수납 높이 = 0.02 ~ 0.78 (약 760mm)
-->
<robot name="robot_stand">

  <material name="frame_gray"> <color rgba="0.55 0.57 0.60 1.0"/> </material>
  <material name="panel_dark"> <color rgba="0.25 0.27 0.30 1.0"/> </material>
  <material name="top_blue">   <color rgba="0.20 0.45 0.75 1.0"/> </material>

  <link name="base_link">

    <!-- 관성 (fix_base_link 사용 시 영향 미미하나 URDF 유효성 위해 기입) -->
    <inertial>
      <origin xyz="0 0 0.4"/>
      <mass value="30.0"/>
      <inertia ixx="1.6" ixy="0" ixz="0" iyy="1.6" iyz="0" izz="1.8"/>
    </inertial>

    <!-- ===== 상판 (로봇 장착면, 윗면 z=0.8) ===== -->
    <visual>
      <origin xyz="0 0 0.79"/>
      <geometry><box size="0.60 0.60 0.02"/></geometry>
      <material name="top_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.79"/>
      <geometry><box size="0.60 0.60 0.02"/></geometry>
    </collision>

    <!-- ===== 바닥판 ===== -->
    <visual>
      <origin xyz="0 0 0.01"/>
      <geometry><box size="0.60 0.60 0.02"/></geometry>
      <material name="frame_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.01"/>
      <geometry><box size="0.60 0.60 0.02"/></geometry>
    </collision>

    <!-- ===== 4 모서리 기둥 (z: 0.02~0.78, 중심 0.40, 길이 0.76) ===== -->
    <visual>
      <origin xyz="0.28 0.28 0.40"/>
      <geometry><cylinder radius="0.015" length="0.76"/></geometry>
      <material name="frame_gray"/>
    </visual>
    <collision>
      <origin xyz="0.28 0.28 0.40"/>
      <geometry><cylinder radius="0.015" length="0.76"/></geometry>
    </collision>

    <visual>
      <origin xyz="-0.28 0.28 0.40"/>
      <geometry><cylinder radius="0.015" length="0.76"/></geometry>
      <material name="frame_gray"/>
    </visual>
    <collision>
      <origin xyz="-0.28 0.28 0.40"/>
      <geometry><cylinder radius="0.015" length="0.76"/></geometry>
    </collision>

    <visual>
      <origin xyz="0.28 -0.28 0.40"/>
      <geometry><cylinder radius="0.015" length="0.76"/></geometry>
      <material name="frame_gray"/>
    </visual>
    <collision>
      <origin xyz="0.28 -0.28 0.40"/>
      <geometry><cylinder radius="0.015" length="0.76"/></geometry>
    </collision>

    <visual>
      <origin xyz="-0.28 -0.28 0.40"/>
      <geometry><cylinder radius="0.015" length="0.76"/></geometry>
      <material name="frame_gray"/>
    </visual>
    <collision>
      <origin xyz="-0.28 -0.28 0.40"/>
      <geometry><cylinder radius="0.015" length="0.76"/></geometry>
    </collision>

    <!-- 패널 없음: 4개 기둥만 있는 개방형 프레임 (사방 트임) -->

  </link>
</robot>
