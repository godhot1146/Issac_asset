  <library_effects>
    <effect id="Material-effect">
      <profile_COMMON>
        <newparam sid="Plastic03-basecolor_jpeg-surface">
          <surface type="2D">
            <init_from>Plastic03-basecolor_jpeg</init_from>
          </surface>
        </newparam>
        <newparam sid="Plastic03-basecolor_jpeg-sampler">
          <sampler2D>
            <source>Plastic03-basecolor_jpeg-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="Plastic03-basecolor_jpeg-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
