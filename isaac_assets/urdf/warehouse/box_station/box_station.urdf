<?xml version="1.0"?>
<robot name="dummy">

  <material name="rack_blue"><color rgba="0.0 0.2 0.6 1.0"/></material>
  <material name="rack_orange"><color rgba="1.0 0.4 0.0 1.0"/></material>

  <link name="dummy">
    
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>

    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="box_station_base.dae"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="box_station_base.dae"/></geometry></collision>

    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="box_station_1.dae"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="box_station_1.dae"/></geometry></collision>

    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="box_station_2.dae"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="box_station_2.dae"/></geometry></collision>

  </link>
</robot>