<?xml version="1.0"?>
<!--
  air_compressor_new.urdf
  바탕화면 "air_compressor_model_make.step-BodyAdditivePipe002.step" → 변환. 단일 바디(링크 1개).
  기존 air_compressor.urdf를 대체하는 새 에어컴프레셔 모델.
  - 원본 STEP 단위 mm → 메쉬 좌표 자체를 m로 스케일 (scale="1 1 1")
  - 원점: 모델 자체 기준점 (중심/바닥 어디에도 안 맞음, x:-0.013~0.483, y:-0.27~0.177, z:-0.249~0.472)
  - 치수 0.483 x 0.447 x 0.721 m (삼각형 3,898면)
  - 시각(visual): 원본 메쉬. 충돌(collision): 박스로 단순화(치수=메쉬 바운딩박스)
  - 정적 소품(스탠드 내부 거치)이므로 스폰 시 AssetOptions.fix_base_link=True 권장
-->
<robot name="air_compressor_new">

  <material name="compressor_dark"> <color rgba="0.20 0.22 0.25 1.0"/> </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0.2286 -0.0464 0.1118"/>
      <mass value="25.0"/>
      <!-- 박스 관성 (m=25, 0.483x0.447x0.721) -->
      <inertia ixx="1.5006" ixy="0" ixz="0" iyy="1.5703" iyz="0" izz="0.9031"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0"/>
      <geometry><mesh filename="meshes/air_compressor_new.stl" scale="1 1 1"/></geometry>
      <material name="compressor_dark"/>
    </visual>

    <collision>
      <origin xyz="0.2286 -0.0464 0.1118"/>
      <geometry><box size="0.483 0.447 0.721"/></geometry>
    </collision>
  </link>
</robot>
