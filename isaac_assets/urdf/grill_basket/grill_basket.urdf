<?xml version="1.0"?>
<!--
  grill_basket.urdf
  이중 그릴 바스켓(석쇠 2연, 손잡이 포함). 단일 바디(링크 1개).
  - 원본: assets/DoubleGrillBasket.step (STEP → STL 변환, mm 단위 → m 스케일) — 개정판,
    이전 DoubleGrillBasket2.step 대비 길이만 10mm 짧아짐(542→532mm), 나머지 형상 동일.
  - 시각(visual): meshes/grill_basket.stl
  - 충돌(collision): 박스로 단순화. 와이어 바스켓 형상 삼각형 면적 분석 결과 Z방향으로
    고르게 분포(뼈대 전체가 하중을 받는 구조)라 바운딩박스 그대로 사용해도 문제없음 확인.
  - 치수 약 0.532 x 0.339 x 0.0348 m
  - 메쉬 원점: y/z는 중심 정렬, x는 0 부근(약간의 손잡이 돌출 -0.005~0.527)
  - 로봇이 집었다 놓는 이동체이므로 스폰 시 fix_base_link=False로 로드할 것
    (work_table/grill처럼 고정하면 안 됨)
-->
<robot name="grill_basket">

  <material name="basket_steel"> <color rgba="0.65 0.65 0.68 1.0"/> </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0.261 0 0"/>
      <mass value="1.5"/>
      <!-- 박스 관성 (m=1.5, 0.532x0.339x0.0348) -->
      <inertia ixx="0.0145" ixy="0" ixz="0" iyy="0.0356" iyz="0" izz="0.0498"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0"/>
      <geometry><mesh filename="meshes/grill_basket.stl" scale="1 1 1"/></geometry>
      <material name="basket_steel"/>
    </visual>

    <!-- 충돌 박스 = 메쉬 바운딩박스 중심/크기 (x:-0.005~0.527, y:-0.17~0.17, z:-0.017~0.017) -->
    <collision>
      <origin xyz="0.261 0 0"/>
      <geometry><box size="0.532 0.339 0.0348"/></geometry>
    </collision>
  </link>
</robot>
