<?xml version="1.0"?>
<robot name="fixed_caser_v1">
 
    <link name="base_link">
        <visual>   <geometry> <mesh filename="base_1.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="base_1.dae"/> </geometry> </collision>

        <visual>   <geometry> <mesh filename="base_2.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="base_2.dae"/> </geometry> </collision>

        <visual>   <geometry> <mesh filename="base_3.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="base_3.dae"/> </geometry> </collision>

        <visual>   <geometry> <mesh filename="base_4.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="base_4.dae"/> </geometry> </collision>
        
        <visual>   <geometry> <mesh filename="base_5.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="base_5.dae"/> </geometry> </collision>

        <visual>   <geometry> <mesh filename="fold_left_1.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="fold_left_1.dae"/> </geometry> </collision>

        <visual>   <geometry> <mesh filename="fold_left_2.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="fold_left_2.dae"/> </geometry> </collision>

        <visual>   <geometry> <mesh filename="fold_right_1.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="fold_right_1.dae"/> </geometry> </collision>

        <visual>   <geometry> <mesh filename="fold_right_2.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="fold_right_2.dae"/> </geometry> </collision>

        <visual>   <geometry> <mesh filename="tape_1.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="tape_1.dae"/> </geometry> </collision>

        <visual>   <geometry> <mesh filename="tape_2.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="tape_2.dae"/> </geometry> </collision>

        <visual>   <geometry> <mesh filename="tape_3.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="tape_3.dae"/> </geometry> </collision>

        <visual>   <geometry> <mesh filename="tape_4.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="tape_4.dae"/> </geometry> </collision>

        <visual>   <geometry> <mesh filename="tape_5.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="tape_5.dae"/> </geometry> </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="1.0"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
    </link>

    <link name="cutter_1_link">
        <visual>   <geometry> <mesh filename="cutter_1.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="cutter_1.dae"/> </geometry> </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.2"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
    </link>

    <joint name="base_to_cutter_joint" type="revolute">
        <parent link="base_link"/>
        <child link="cutter_1_link"/>
        <origin xyz="-0.245 0 0.01" rpy="0 0 0"/> <axis xyz="0 1 0"/>               
        <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
    </joint>

    <link name="cutter_children_link">
        <visual>   <geometry> <mesh filename="cutter_2.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="cutter_2.dae"/> </geometry> </collision>
        <visual>   <geometry> <mesh filename="cutter_3.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="cutter_3.dae"/> </geometry> </collision>
        <visual>   <geometry> <mesh filename="cutter_4.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="cutter_4.dae"/> </geometry> </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.3"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
    </link>

    <joint name="cutter_1_to_children" type="fixed">
        <parent link="cutter_1_link"/>
        <child link="cutter_children_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>


    <link name="taping_front_1_link">
        <visual>   <geometry> <mesh filename="taping_front_1.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="taping_front_1.dae"/> </geometry> </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.2"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
    </link>

    <joint name="base_to_taping_front_joint" type="revolute">
        <parent link="base_link"/>
        <child link="taping_front_1_link"/>
        <origin xyz="0.245 0 0.01" rpy="0 0 0"/> <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
    </joint>

    <link name="taping_front_children_link">
        <visual>   <geometry> <mesh filename="taping_front_2.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="taping_front_2.dae"/> </geometry> </collision>
        <visual>   <geometry> <mesh filename="taping_front_3.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="taping_front_3.dae"/> </geometry> </collision>
        <visual>   <geometry> <mesh filename="taping_front_4.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="taping_front_4.dae"/> </geometry> </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.3"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
    </link>

    <joint name="taping_front_1_to_children" type="fixed">
        <parent link="taping_front_1_link"/>
        <child link="taping_front_children_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>


    <link name="taping_back_1_link">
        <visual>   <geometry> <mesh filename="taping_back_1.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="taping_back_1.dae"/> </geometry> </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.2"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
    </link>

    <joint name="base_to_taping_back_joint" type="revolute">
        <parent link="base_link"/>
        <child link="taping_back_1_link"/>
        <origin xyz="-0.245 0 0.03" rpy="0 0 0"/> <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
    </joint>

    <link name="taping_back_children_link">
        <visual>   <geometry> <mesh filename="taping_back_2.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="taping_back_2.dae"/> </geometry> </collision>
        <visual>   <geometry> <mesh filename="taping_back_3.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="taping_back_3.dae"/> </geometry> </collision>
        <visual>   <geometry> <mesh filename="taping_back_4.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="taping_back_4.dae"/> </geometry> </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.3"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
    </link>

    <joint name="taping_back_1_to_children" type="fixed">
        <parent link="taping_back_1_link"/>
        <child link="taping_back_children_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

</robot>