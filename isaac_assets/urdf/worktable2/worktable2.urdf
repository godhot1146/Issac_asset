<?xml version="1.0"?>
<!--
  worktable2.urdf
  Downloads/WorkTable2.step → 재변환된 작업대. 단일 바디(링크 1개).
  (기존 asset을 새 STEP 파일 기준으로 갱신 — FreeCAD(freecadcmd)로 STEP→STL 테셀레이션 후 trimesh로 mm→m 스케일)
  - 원본 STEP 단위 mm → 메쉬 좌표 자체를 m로 스케일 (scale="1 1 1")
  - 원점: 테이블 바닥면 한쪽 모서리 (x:0~0.9, y:0~0.6, z:0~0.94)
  - 시각(visual): meshes/worktable2.stl
  - 상판은 평평한 한 면이 아니라 2단 구조: 대부분(y:0~0.56)은 z=0.84(메인 상판),
    뒤쪽 얇은 턱(y:0.56~0.6)만 z=0.94(전체 높이)로 10cm 더 높음. (메쉬 정점 분석으로 확인)
  - 충돌(collision): 박스 2개(메인 상판/뒤쪽 턱)로 실제 2단 형태에 맞게 분리
    (이전 버전에서 바운딩박스 1개로 단순화했을 때 물체가 뜨는 문제가 있었음 — 동일 이슈 방지)
  - 치수 0.90 x 0.60 x 0.94 m
  - 질량/관성: 실측 CAD 재질 정보가 없어 15kg(스테인리스 프렙테이블 실측 통상치)로 가정,
    watertight 메쉬 실체적 기준 균일밀도로 trimesh가 계산한 값(질량중심이 하부 선반 쪽으로 치우침, 정상)
  - 정적 구조물이므로 스폰 시 AssetOptions.fix_base_link=True 권장
-->
<robot name="worktable2">

  <material name="table_gray"> <color rgba="0.65 0.65 0.65 1.0"/> </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0.44999943 0.27504407 0.30076219"/>
      <mass value="15.0"/>
      <inertia ixx="1.660771" ixy="-0.000008" ixz="-0.000008" iyy="2.461216" iyz="0.062366" izz="1.773268"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0"/>
      <geometry><mesh filename="meshes/worktable2.stl" scale="1 1 1"/></geometry>
      <material name="table_gray"/>
    </visual>

    <!-- 메인 상판 영역: x:0~0.9, y:0~0.56, z:0~0.84 -->
    <collision>
      <origin xyz="0.45 0.28 0.42"/>
      <geometry><box size="0.90 0.56 0.84"/></geometry>
    </collision>
    <!-- 뒤쪽 턱 영역: x:0~0.9, y:0.56~0.6, z:0~0.94 -->
    <collision>
      <origin xyz="0.45 0.58 0.47"/>
      <geometry><box size="0.90 0.04 0.94"/></geometry>
    </collision>
  </link>
</robot>
