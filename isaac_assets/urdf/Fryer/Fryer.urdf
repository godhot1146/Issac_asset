<?xml version="1.0"?>
<!--
  Fryer.urdf
  바탕화면 deep_fryer.step → 변환 (2단 바스켓/조리조 + 뒷쪽 조작판, 다리 4개). 단일 바디(링크 1개).
  - 원본 STEP 단위 mm → mm 단위로 먼저 테셀레이션 후 정점만 m로 스케일하는 방식으로 변환
    (FreeCAD Part.Shape.tessellate, deflection=0.3mm), 삼각형 1,186면.
  - 원점: 모델 자체 기준점. XY는 중심 정렬(x:-0.45~0.45, y:-0.3~0.3), Z는 바닥(0~1.0).
  - 치수 0.90 x 0.60 x 1.00 m
  - 시각(visual): 원본 메쉬. 충돌(collision): 원본 메쉬 그대로 사용 — 조리조가 오목한 형상이라
    박스로 단순화하면 바스켓이 들어갈 공간이 막힘. 스폰 시 AssetOptions.vhacd_enabled=True(볼록분해)로
    로드할 것(예: run_deepfry_B.py 참고) — 원본 그대로는 바닥/바스켓 접촉이 불안정함. 정적 바디라 성능 영향 없음.
  - 바닥에 고정 설치되는 조리기기이므로 스폰 시 AssetOptions.fix_base_link=True 권장
-->
<robot name="Fryer">

  <material name="fryer_steel"> <color rgba="0.75 0.75 0.75 1.0"/> </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.5"/>
      <mass value="15.0"/>
      <!-- 박스 관성 (m=15, 0.90x0.60x1.00) -->
      <inertia ixx="1.708" ixy="0" ixz="0" iyy="2.271" iyz="0" izz="1.4625"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0"/>
      <geometry><mesh filename="meshes/Fryer.stl" scale="1 1 1"/></geometry>
      <material name="fryer_steel"/>
    </visual>

    <collision>
      <origin xyz="0 0 0"/>
      <geometry><mesh filename="meshes/Fryer.stl" scale="1 1 1"/></geometry>
    </collision>
  </link>
</robot>
