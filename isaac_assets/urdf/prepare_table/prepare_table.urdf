<?xml version="1.0"?>
<!--
  prepare_table.urdf
  Prepare table V2, converted from prepare_table_v2.step.
  - visual: meshes/prepare_table.stl (metres, XY-centred, floor z=0)
  - collision: explicit convex top prisms plus lower-frame box primitives
  - bounding-box size: 1.2 x 1.2 x 0.85 m
  - volume: 0.0288193971 m^3
  - mass/inertia: uniform stainless steel at 7850 kg/m^3
-->
<robot name="prepare_table">

  <material name="prepare_table_stainless">
    <color rgba="0.62 0.64 0.66 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="-0.200255281 -0.200255281 0.676644628" rpy="0 0 0"/>
      <mass value="226.232268"/>
      <inertia
          ixx="52.2125676" ixy="19.0986592" ixz="2.27857111"
          iyy="52.2125676" iyz="2.27857111" izz="78.4342135"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/prepare_table.stl" scale="1 1 1"/>
      </geometry>
      <material name="prepare_table_stainless"/>
    </visual>

    <!-- Exact lower-frame boxes from the source STEP; top prisms cover z=0.810..0.850 m. -->
    <collision name="leg_outer_x">
      <origin xyz="0.572 -0.378 0.405" rpy="0 0 0"/>
      <geometry><box size="0.045 0.045 0.810"/></geometry>
    </collision>
    <collision name="leg_inner_corner">
      <origin xyz="-0.378 -0.378 0.405" rpy="0 0 0"/>
      <geometry><box size="0.045 0.045 0.810"/></geometry>
    </collision>
    <collision name="leg_origin_corner">
      <origin xyz="-0.572 -0.572 0.405" rpy="0 0 0"/>
      <geometry><box size="0.045 0.045 0.810"/></geometry>
    </collision>
    <collision name="leg_outer_y">
      <origin xyz="-0.572 0.572 0.405" rpy="0 0 0"/>
      <geometry><box size="0.045 0.045 0.810"/></geometry>
    </collision>
    <collision name="leg_x_end">
      <origin xyz="0.572 -0.572 0.405" rpy="0 0 0"/>
      <geometry><box size="0.045 0.045 0.810"/></geometry>
    </collision>
    <collision name="leg_y_end">
      <origin xyz="-0.378 0.572 0.405" rpy="0 0 0"/>
      <geometry><box size="0.045 0.045 0.810"/></geometry>
    </collision>
    <collision name="rail_y">
      <origin xyz="-0.572 0 0.7725" rpy="0 0 0"/>
      <geometry><box size="0.025 1.099 0.075"/></geometry>
    </collision>
    <collision name="rail_x">
      <origin xyz="0 -0.572 0.7725" rpy="0 0 0"/>
      <geometry><box size="1.099 0.025 0.075"/></geometry>
    </collision>

    <!-- 397 convex prisms tessellated from the exact STEP top face. All ten
         circular bowl openings and their gripper-entry slots remain open. -->
    <collision name="top_000">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/collision/prepare_table_top_000.stl" scale="1 1 1"/>
      </geometry>
    </collision>

    <collision name="top_001">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
