<?xml version="1.0"?>
<robot name="forklift_amr">

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry> <box size="0.1 0.1 0.1"/> </geometry>
    </visual>
    <collision>
      <geometry> <box size="0.1 0.1 0.1"/> </geometry>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <inertia ixx="5.0" ixy="0.0" ixz="0.0" iyy="5.0" iyz="0.0" izz="5.0"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0.0 0.35 -0.071" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="left_wheel_link">
    <visual>   <geometry> <mesh filename="wheel/wheel_texture.dae"/> </geometry> </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry> 
        <cylinder radius="0.075" length="0.1"/> 
      </geometry> 
    </collision>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0.0 -0.35 -0.071" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="right_wheel_link">
    <visual>   <geometry> <mesh filename="wheel/wheel_texture.dae"/> </geometry> </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry> 
        <cylinder radius="0.075" length="0.1"/> 
      </geometry> 
    </collision>
  </link>

  <joint name="middle_wheel_joint" type="fixed">
    <parent link="base_link"/> <child link="middle_wheel_link"/>
    <origin xyz="-0.05 0.0 -0.04" rpy="0 0 0"/>
  </joint>
  <link name="middle_wheel_link">
    <visual>   <geometry> <mesh filename="wheel/wheel_middle.dae"/> </geometry> </visual>
    <collision><geometry> <mesh filename="wheel/wheel_middle.dae"/> </geometry> </collision>
  </link>

  <joint name="cast_wheel_joint1" type="revolute">
    <parent link="base_link"/> 
    <child link="cast_wheel_link1"/>
    <origin xyz="1.25 -0.2225 -0.09" rpy="0 0 0"/>
    <axis xyz="0 1 0"/> <limit lower="0.0" upper="1.5708" effort="100.0" velocity="1.0"/> 
  </joint>
  <link name="cast_wheel_link1">
    <visual>   <geometry> <mesh filename="castor/castor1.dae"/> </geometry> </visual>
    <collision><geometry> <mesh filename="castor/castor1.dae"/> </geometry> </collision>



    <visual>   <geometry> <mesh filename="castor/castor3.dae"/> </geometry> </visual>
    <collision><geometry> <mesh filename="castor/castor3.dae"/> </geometry> </collision>

    <visual>   <geometry> <mesh filename="castor/castor4.dae"/> </geometry> </visual>
    <collision><geometry> <mesh filename="castor/castor4.dae"/> </geometry> </collision>
  </link>

  <joint name="cast_wheel_joint2" type="revolute">
    <parent link="base_link"/> 
    <child link="cast_wheel_link2"/>
    <origin xyz="1.25 0.2225 -0.09" rpy="0 0 0"/>
    <axis xyz="0 1 0"/> <limit lower="0.0" upper="1.5708" effort="100.0" velocity="1.0"/>
  </joint>
  <link name="cast_wheel_link2">
    <visual>   <geometry> <mesh filename="castor/castor1.dae"/> </geometry> </visual>
    <collision><geometry> <mesh filename="castor/castor1.dae"/> </geometry> </collision>



    <visual>   <geometry> <mesh filename="castor/castor3.dae"/> </geometry> </visual>
    <collision><geometry> <mesh filename="castor/castor3.dae"/> </geometry> </collision>

    <visual>   <geometry> <mesh filename="castor/castor4.dae"/> </geometry> </visual>
    <collision><geometry> <mesh filename="castor/castor4.dae"/> </geometry> </collision>
  </link>

  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="mast_link">
    <visual>   <geometry> <mesh filename="base/base1_1.dae"/> </geometry> </visual>
    <collision><geometry> <mesh filename="base/base1_1.dae"/> </geometry> </collision>

    <visual>   <geometry> <mesh filename="base/base1_2.dae"/> </geometry> </visual>
    <collision><geometry> <mesh filename="base/base1_2.dae"/> </geometry> </collision>

    <visual>   <geometry> <mesh filename="base/base1_3.dae"/> </geometry> </visual>
    <collision><geometry> <mesh filename="base/base1_3.dae"/> </geometry> </collision>

    <visual>   <geometry> <mesh filename="base/base1_4.dae"/> </geometry> </visual>
    <collision><geometry> <mesh filename="base/base1_4.dae"/> </geometry> </collision>

    <visual>   <geometry> <mesh filename="base/base1_5.dae"/> </geometry> </visual>
    <collision><geometry> <mesh filename="base/base1_5.dae"/> </geometry> </collision>

    <visual>   <geometry> <mesh filename="base/base2.dae"/> </geometry> </visual>
    <collision><geometry> <mesh filename="base/base2.dae"/> </geometry> </collision>

    <visual>   <geometry> <mesh filename="base/base3.dae"/> </geometry> </visual>
    <collision><geometry> <mesh filename="base/base3.dae"/> </geometry> </collision>

    <visual>   <geometry> <mesh filename="base/base4.dae"/> </geometry> </visual>
    <collision><geometry> <mesh filename="base/base4.dae"/> </geometry> </collision>

    <visual>   <geometry> <mesh filename="base/base5.dae"/> </geometry> </visual>
    <collision><geometry> <mesh filename="base/base5.dae"/> </geometry> </collision>

    <visual>   <geometry> <mesh filename="base/base6.dae"/> </geometry> </visual>
    <collision><geometry> <mesh filename="base/base6.dae"/> </geometry> </collision>

    <visual>   <geometry> <mesh filename="base/base7.dae"/> </geometry> </visual>
    <collision><geometry> <mesh filename="base/base7.dae"/> </geometry> </collision>
    
    <inertial>
      <mass value="10.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.2" ixy="0.0" ixz="0.0" iyy="0.2" iyz="0.0" izz="0.05"/>
    </inertial>
  </link>

  <joint name="lift_z_joint" type="prismatic">
    <parent link="mast_link"/>
    <child link="lift_shuttle_link"/>
    <origin xyz="0.36 0 0.23" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.1" upper="0.3" effort="50000" velocity="0.5"/>
  </joint>
  
  <link name="lift_shuttle_link">
    <visual> <geometry> <mesh filename="lift/lift1.dae"/> </geometry> </visual>
    <collision> <geometry> <mesh filename="lift/lift1.dae"/> </geometry> </collision>

    <visual> <geometry> <mesh filename="lift/lift2.dae"/> </geometry> </visual>
    <collision> <geometry> <mesh filename="lift/lift2.dae"/> </geometry> </collision>

    <visual> <geometry> <mesh filename="lift/lift3.dae"/> </geometry> </visual>
    <collision> <geometry> <mesh filename="lift/lift3.dae"/> </geometry> </collision>

    <visual> <geometry> <mesh filename="lift/lift4.dae"/> </geometry> </visual>
    <collision> <geometry> <mesh filename="lift/lift4.dae"/> </geometry> </collision>

    <visual> <geometry> <mesh filename="lift/lift5.dae"/> </geometry> </visual>
    <collision> <geometry> <mesh filename="lift/lift5.dae"/> </geometry> </collision>
    
    <inertial>
      <mass value="20.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

</robot>