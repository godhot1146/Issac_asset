<?xml version="1.0"?>
<!--
  grill900.urdf
  업소용 스테이크 그릴러(삿갓버너 6구, 900mm 폭). 단일 바디(링크 1개).
  - 원본: assets/grill900.step (STEP → STL 변환, mm 단위 → m 스케일) — 기존 grill(1500mm/9구,
    Grill2.step)과 별개 에셋으로 공존. 깊이/높이/원점 규칙은 grill과 동일.
  - 시각(visual): meshes/grill900.stl
  - 충돌(collision): 박스로 단순화. 삼각형 면적 분석 결과 최상단(800mm)에 실제 넓은 면적이
    있는 진짜 상판이라(핀/립 아님) 바운딩박스 그대로 사용해도 문제없음.
  - 치수 약 0.90 x 0.70 x 0.80 m (900x600x800, 조작 손잡이 돌출 포함)
  - 메쉬 원점은 바닥 모서리(x=0,y=0,z=0)에 정렬됨 (센터가 아님) → 배치 시 참고
-->
<robot name="grill900">

  <material name="grill900_steel"> <color rgba="0.55 0.55 0.58 1.0"/> </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0.45 0.2525 0.4"/>
      <mass value="48.0"/>
      <!-- 박스 관성 (m=48, 0.9x0.695x0.8) -->
      <inertia ixx="4.49" ixy="0" ixz="0" iyy="5.80" iyz="0" izz="5.17"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0"/>
      <geometry><mesh filename="meshes/grill900.stl" scale="1 1 1"/></geometry>
      <material name="grill900_steel"/>
    </visual>

    <!-- 충돌 박스 = 메쉬 바운딩박스 중심/크기 (x:0~0.9, y:-0.095~0.6, z:0~0.8) -->
    <collision>
      <origin xyz="0.45 0.2525 0.4"/>
      <geometry><box size="0.9 0.695 0.8"/></geometry>
    </collision>
  </link>
</robot>
