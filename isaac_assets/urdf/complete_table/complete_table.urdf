<?xml version="1.0"?>
<!--
  complete_table.urdf
  Complete table V2, converted from complete_table_v2.step.
  - visual: meshes/complete_table.stl (metres, XY-centred, floor z=0)
  - collision: explicit convex top prisms plus lower-frame box primitives
  - bounding-box size: 1 x 0.35 x 0.85 m
  - volume: 0.0211619404 m^3
  - mass/inertia: uniform stainless steel at 7850 kg/m^3
-->
<robot name="complete_table">

  <material name="complete_table_stainless">
    <color rgba="0.62 0.64 0.66 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="-0.0128140967 0.0137472873 0.693653881" rpy="0 0 0"/>
      <mass value="166.121232"/>
      <inertia
          ixx="11.5401152" ixy="-0.113911095" ixz="0.2902391"
          iyy="30.0569243" iyz="-0.199531054" izz="23.4088639"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/complete_table.stl" scale="1 1 1"/>
      </geometry>
      <material name="complete_table_stainless"/>
    </visual>

    <!-- Exact lower-frame boxes from the source STEP; top prisms cover z=0.810..0.850 m. -->
    <collision name="leg_front_left">
      <origin xyz="-0.472 -0.147 0.405" rpy="0 0 0"/>
      <geometry><box size="0.045 0.045 0.810"/></geometry>
    </collision>
    <collision name="leg_front_right">
      <origin xyz="0.472 -0.147 0.405" rpy="0 0 0"/>
      <geometry><box size="0.045 0.045 0.810"/></geometry>
    </collision>
    <collision name="leg_back_left">
      <origin xyz="-0.472 0.147 0.405" rpy="0 0 0"/>
      <geometry><box size="0.045 0.045 0.810"/></geometry>
    </collision>
    <collision name="leg_back_right">
      <origin xyz="0.472 0.147 0.405" rpy="0 0 0"/>
      <geometry><box size="0.045 0.045 0.810"/></geometry>
    </collision>
    <collision name="back_rail">
      <origin xyz="0 0.147 0.7725" rpy="0 0 0"/>
      <geometry><box size="0.899 0.025 0.075"/></geometry>
    </collision>

    <!-- 72 convex prisms tessellated from the exact STEP top face. The circular
         bowl opening and its horizontal gripper-entry slot remain open. -->
    <collision name="top_000">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/collision/complete_table_top_000.stl" scale="1 1 1"/>
