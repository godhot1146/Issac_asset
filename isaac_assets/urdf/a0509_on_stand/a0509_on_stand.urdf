<?xml version="1.0"?>
<!-- a0509_on_stand.urdf : 선반 + A0509를 fixed joint로 결합한 통합 에셋.
     root = stand_base_link. 로봇은 선반 상단(z=0.8)에 고정됨.
     fix_base_link=False로 로드하면 통째로 바닥에 얹힘(월드 비고정). -->
<robot name="a0509_on_stand">

  <!-- ===== 선반(스탠드): 60x60x80cm, 기둥 Ø30 원기둥만, 사방 개방 ===== -->
  <material name="frame_gray"> <color rgba="0.55 0.57 0.60 1.0"/> </material>
  <material name="top_blue">   <color rgba="0.20 0.45 0.75 1.0"/> </material>

  <link name="stand_base_link">
    <inertial>
      <origin xyz="0 0 0.4"/>
      <mass value="35.0"/>
      <inertia ixx="1.8" ixy="0" ixz="0" iyy="1.8" iyz="0" izz="2.0"/>
    </inertial>
    <!-- 상판 (윗면 z=0.8 = 로봇 장착면) -->
    <visual>   <origin xyz="0 0 0.79"/> <geometry><box size="0.60 0.60 0.02"/></geometry> <material name="top_blue"/> </visual>
    <collision><origin xyz="0 0 0.79"/> <geometry><box size="0.60 0.60 0.02"/></geometry></collision>
    <!-- 바닥판 -->
    <visual>   <origin xyz="0 0 0.01"/> <geometry><box size="0.60 0.60 0.02"/></geometry> <material name="frame_gray"/> </visual>
    <collision><origin xyz="0 0 0.01"/> <geometry><box size="0.60 0.60 0.02"/></geometry></collision>
    <!-- 4 모서리 기둥 (Ø30, z 0.02~0.78) -->
    <visual>   <origin xyz="0.28 0.28 0.40"/>   <geometry><cylinder radius="0.015" length="0.76"/></geometry> <material name="frame_gray"/> </visual>
    <collision><origin xyz="0.28 0.28 0.40"/>   <geometry><cylinder radius="0.015" length="0.76"/></geometry></collision>
    <visual>   <origin xyz="-0.28 0.28 0.40"/>  <geometry><cylinder radius="0.015" length="0.76"/></geometry> <material name="frame_gray"/> </visual>
    <collision><origin xyz="-0.28 0.28 0.40"/>  <geometry><cylinder radius="0.015" length="0.76"/></geometry></collision>
    <visual>   <origin xyz="0.28 -0.28 0.40"/>  <geometry><cylinder radius="0.015" length="0.76"/></geometry> <material name="frame_gray"/> </visual>
    <collision><origin xyz="0.28 -0.28 0.40"/>  <geometry><cylinder radius="0.015" length="0.76"/></geometry></collision>
    <visual>   <origin xyz="-0.28 -0.28 0.40"/> <geometry><cylinder radius="0.015" length="0.76"/></geometry> <material name="frame_gray"/> </visual>
    <collision><origin xyz="-0.28 -0.28 0.40"/> <geometry><cylinder radius="0.015" length="0.76"/></geometry></collision>
  </link>

  <!-- 로봇 베이스를 선반 상단(z=0.8)에 볼트 체결 (fixed joint) -->
  <joint name="stand_to_robot" type="fixed">
    <origin xyz="0 0 0.8" rpy="0 0 0"/>
    <parent link="stand_base_link"/>
    <child  link="base_link"/>
  </joint>

		<link name="base_link">
			<inertial>
				<mass value="2.198"/>
				<origin xyz="-1e-06   -0.001096    0.058957"/>
				<inertia ixx="0.010511" ixy="4.9786e-06" ixz="7.1839e-06" iyy="0.012033"
					iyz="-2.3529e-05"
					izz="0.012481"/>
			</inertial>
			<collision>
				<origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
					<mesh filename="../doosan_a0509/meshes/a0509_collision/A0509_0_0.stl" scale="1 1 1" />
                </geometry>
            </collision>
			<visual>
				<origin rpy="0 0 0" xyz="0 0 0" />
				<geometry>
					<mesh filename="../doosan_a0509/meshes/a0509_white/A0509_0_0.stl" scale="1 1 1" />
				</geometry>
			</visual>
		</link>
		<link name="base"/>
		<joint name="base_link-base" type="fixed">
			<origin rpy="0 0 0" xyz="0 0 0.450"/>
			<parent link="base_link"/>
			<child link="base"/>
		</joint>
		<!-- joint 1 -->
		<joint name="joint_1" type="revolute">
			<parent link="base_link" />
			<child link="link_1" />
			<origin rpy="0 0 0" xyz="0 0 0.1560" />
			<axis xyz="0 0 1" />
			<limit effort="194" lower="-6.2832" upper="6.2832" velocity="3.1416"/>
			<dynamics friction="0" />
		</joint>
		<link name="link_1">
			<inertial>
				<mass value="3.715"/>
				<origin xyz="-6.9e-05    0.024423   -0.007375"/>
				<inertia ixx="0.01899" ixy="7.8574e-07" ixz="1.865e-05" iyy="0.013731" iyz="-0.00072828"
					izz="0.01686"/>
			</inertial>
            <collision>
				<origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
					<mesh filename="../doosan_a0509/meshes/a0509_collision/A0509_1_0.stl" scale="1 1 1" />
                </geometry>
            </collision>
			<visual>
				<origin rpy="0 0 0" xyz="0 0 0" />
				<geometry>
					<mesh filename="../doosan_a0509/meshes/a0509_white/A0509_1_0.stl" scale="1 1 1" />
				</geometry>
			</visual>
			<collision>
				<origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
					<mesh filename="../doosan_a0509/meshes/a0509_collision/A0509_1_1.stl" scale="1 1 1" />
                </geometry>
            </collision>
            <visual>
				<origin rpy="0 0 0" xyz="0 0 0" />
				<geometry>
					<mesh filename="../doosan_a0509/meshes/a0509_white/A0509_1_1.stl" scale="1 1 1" />
				</geometry>
			</visual>
			<collision>
				<origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
					<mesh filename="../doosan_a0509/meshes/a0509_collision/A0509_1_2.stl" scale="1 1 1" />
                </geometry>
            </collision>
            <visual>
				<origin rpy="0 0 0" xyz="0 0 0" />
				<geometry>
					<mesh filename="../doosan_a0509/meshes/a0509_white/A0509_1_2.stl" scale="1 1 1" />
				</geometry>
			</visual>
		</link>
		<!-- joint2 -->
		<joint name="joint_2" type="revolute">
			<parent link="link_1" />
			<child link="link_2" />
			<origin rpy="0 -1.571 -1.571" xyz="0 0 0" />
			<axis xyz="0 0 1" />
			<limit effort="194" lower="-6.2832" upper="6.2832" velocity="3.1416"/>
			<dynamics friction="0" />
		</joint>
		<link name="link_2">
			<inertial>
				<mass value="6.837"/>
				<origin xyz="0.20449 -1.2521e-17     0.13271"/>
				<inertia ixx="0.019399" ixy="0.00010317" ixz="4.2985e-06" iyy="0.25627" iyz="5.1674e-06"
					izz="0.25442"/>
			</inertial>
            <collision>
				<origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
					<mesh filename="../doosan_a0509/meshes/a0509_collision/A0509_2_0.stl" scale="1 1 1" />
                </geometry>
            </collision>
			<visual>
				<origin rpy="0 0 0" xyz="0 0 0" />
				<geometry>
					<mesh filename="../doosan_a0509/meshes/a0509_white/A0509_2_0.stl" scale="1 1 1" />
				</geometry>
			</visual>
			<collision>
				<origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
					<mesh filename="../doosan_a0509/meshes/a0509_collision/A0509_2_1.stl" scale="1 1 1" />
                </geometry>
            </collision>
			<visual>
				<origin rpy="0 0 0" xyz="0 0 0" />
				<geometry>
					<mesh filename="../doosan_a0509/meshes/a0509_white/A0509_2_1.stl" scale="1 1 1" />
				</geometry>
			</visual>
			<collision>
				<origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
					<mesh filename="../doosan_a0509/meshes/a0509_collision/A0509_2_2.stl" scale="1 1 1" />
                </geometry>
            </collision>
			<visual>
				<origin rpy="0 0 0" xyz="0 0 0" />
				<geometry>
					<mesh filename="../doosan_a0509/meshes/a0509_white/A0509_2_2.stl" scale="1 1 1" />
				</geometry>
			</visual>
		</link>
		<!-- joint3 -->
		<joint name="joint_3" type="revolute">
			<parent link="link_2" />
			<child link="link_3" />
			<origin rpy="0 0 1.571" xyz="0.409 0 0" />
			<axis xyz="0 0 1" />
			<limit effort="163" lower="-2.7925" upper="2.7925" velocity="3.1416"/>
			<dynamics friction="0" />
		</joint>
		<link name="link_3">
			<inertial>
				<mass value="2.769"/>
				<origin xyz="7.1e-05   -0.005123    0.033009"/>
				<inertia ixx="0.012526" ixy="-7.1869e-06" ixz="1.3345e-05" iyy="0.013868"
					iyz="-0.00047287"
					izz="0.0088186"/>
			</inertial>
			<collision>
				<origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
					<mesh filename="../doosan_a0509/meshes/a0509_collision/A0509_3_0.stl" scale="1 1 1" />
                </geometry>
            </collision>
			<visual>
				<origin rpy="0 0 0" xyz="0 0 0" />
				<geometry>
					<mesh filename="../doosan_a0509/meshes/a0509_white/A0509_3_0.stl" scale="1 1 1" />
				</geometry>
			</visual>
			<collision>
				<origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
					<mesh filename="../doosan_a0509/meshes/a0509_collision/A0509_3_1.stl" scale="1 1 1" />
                </geometry>
            </collision>
            <visual>
				<origin rpy="0 0 0" xyz="0 0 0" />
				<geometry>
					<mesh filename="../doosan_a0509/meshes/a0509_white/A0509_3_1.stl" scale="1 1 1" />
				</geometry>
			</visual>
		</link>
		<!-- joint4 -->
		<joint name="joint_4" type="revolute">
			<parent link="link_3" />
			<child link="link_4" />
			<origin rpy="1.571 0 0" xyz="0 -0.367 0" />
			<axis xyz="0 0 1" />
			<limit effort="50" lower="-6.2832" upper="6.2832" velocity="6.2832"/>
			<dynamics friction="0" />
		</joint>
		<link name="link_4">
			<inertial>
				<mass value="2.679"/>
				<origin xyz="-8.6e-05    0.086348   -0.086031"/>
				<inertia ixx="0.056068" ixy="2.2109e-05" ixz="1.4522e-05" iyy="0.047122" iyz="-0.014997"
					izz="0.013329"/>
			</inertial>
            <collision>
				<origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
					<mesh filename="../doosan_a0509/meshes/a0509_collision/A0509_4_0.stl" scale="1 1 1" />
                </geometry>
            </collision>
			<visual>
				<origin rpy="0 0 0" xyz="0 0 0" />
				<geometry>
					<mesh filename="../doosan_a0509/meshes/a0509_white/A0509_4_0.stl" scale="1 1 1" />
				</geometry>
			</visual>
			<collision>
				<origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
					<mesh filename="../doosan_a0509/meshes/a0509_collision/A0509_4_1.stl" scale="1 1 1" />
                </geometry>
            </collision>
			<visual>
				<origin rpy="0 0 0" xyz="0 0 0" />
				<geometry>
					<mesh filename="../doosan_a0509/meshes/a0509_white/A0509_4_1.stl" scale="1 1 1" />
				</geometry>
			</visual>
		</link>
		<!-- joint5 -->
		<joint name="joint_5" type="revolute">
			<parent link="link_4" />
			<child link="link_5" />
			<origin rpy="-1.571 0 0" xyz="0 0 0" />
			<axis xyz="0 0 1" />
			<limit effort="50" lower="-6.2832" upper="6.2832" velocity="6.2832"/>
			<dynamics friction="0" />
		</joint>
		<link name="link_5">
			<inertial>
				<mass value="2.051"/>
				<origin xyz="9.1e-05   -0.006457    0.015434"/>
				<inertia ixx="0.0090788" ixy="-5.3997e-06" ixz="8.3955e-06" iyy="0.0084721"
					iyz="-0.0001816"
					izz="0.010453"/>
			</inertial>
            <collision>
				<origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
					<mesh filename="../doosan_a0509/meshes/a0509_collision/A0509_5_0.stl" scale="1 1 1" />
                </geometry>
            </collision>
			<visual>
				<origin rpy="0 0 0" xyz="0 0 0" />
				<geometry>
					<mesh filename="../doosan_a0509/meshes/a0509_white/A0509_5_0.stl" scale="1 1 1" />
				</geometry>
			</visual>
			<collision>
				<origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
					<mesh filename="../doosan_a0509/meshes/a0509_collision/A0509_5_1.stl" scale="1 1 1" />
                </geometry>
            </collision>
            <visual>
				<origin rpy="0 0 0" xyz="0 0 0" />
				<geometry>
					<mesh filename="../doosan_a0509/meshes/a0509_white/A0509_5_1.stl" scale="1 1 1" />
				</geometry>
			</visual>
		</link>
		<!-- joint6 -->
		<joint name="joint_6" type="revolute">
			<parent link="link_5" />
			<child link="link_6" />
			<origin rpy="1.571 0 0" xyz="0 -0.124 0" />
			<axis xyz="0 0 1" />
			<limit effort="50" lower="-6.2832" upper="6.2832" velocity="6.2832"/>
			<dynamics friction="0" />
		</joint>
		<link name="link_6">
			<inertial>
				<mass value="0.773"/>
				<origin xyz="-2.2e-05      -7e-06   -0.051746"/>
				<inertia ixx="0.0087483" ixy="7.9428e-06" ixz="1.7034e-06" iyy="0.0078566"
					iyz="9.6857e-06"
					izz="0.0044452"/>
			</inertial>
			<collision>
				<origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
					<mesh filename="../doosan_a0509/meshes/a0509_collision/A0509_6_0.stl" scale="1 1 1" />
                </geometry>
            </collision>
			<visual>
				<origin rpy="0 0 0" xyz="0 0 0" />
				<geometry>
					<mesh filename="../doosan_a0509/meshes/a0509_white/A0509_6_0.stl" scale="1 1 1" />
				</geometry>
			</visual>
		</link>
		<!-- <link name="tool0"/>
		<joint name="joint_6-tool0" type="fixed">
			<origin rpy="3.1415926535 -1.570796327 0" xyz="0 0 0"/>
			<parent link="link_6"/>
			<child link="tool0"/>
		</joint> -->
</robot>
