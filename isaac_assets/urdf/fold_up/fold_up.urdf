<?xml version="1.0"?>
<robot name="fixed_caser_v1">
 
    <link name="base_link">
        <visual>   <geometry> <mesh filename="base1.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="base1.dae"/> </geometry> </collision>

        <visual>   <geometry> <mesh filename="base2.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="base2.dae"/> </geometry> </collision>

        <visual>   <geometry> <mesh filename="base3.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="base3.dae"/> </geometry> </collision>

        <visual>   <geometry> <mesh filename="base4.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="base4.dae"/> </geometry> </collision>
        
        <visual>   <geometry> <mesh filename="base5.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="base5.dae"/> </geometry> </collision>

        <visual>   <geometry> <mesh filename="base6.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="base6.dae"/> </geometry> </collision>

        <visual>   <geometry> <mesh filename="fold_left1.dae"/> </geometry> </visual>
        <visual>   <geometry> <mesh filename="fold_left2.dae"/> </geometry> </visual>
        <visual>   <geometry> <mesh filename="fold_right1.dae"/> </geometry> </visual>
        <visual>   <geometry> <mesh filename="fold_right2.dae"/> </geometry> </visual>

        <visual>   <geometry> <mesh filename="fix1.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="fix1.dae"/> </geometry> </collision>
        <visual>   <geometry> <mesh filename="fix2.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="fix2.dae"/> </geometry> </collision>
        <visual>   <geometry> <mesh filename="fix3.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="fix3.dae"/> </geometry> </collision>
        <visual>   <geometry> <mesh filename="fix4.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="fix4.dae"/> </geometry> </collision>
        <visual>   <geometry> <mesh filename="fix5.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="fix5.dae"/> </geometry> </collision>
        <visual>   <geometry> <mesh filename="fix6.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="fix6.dae"/> </geometry> </collision>
        <visual>   <geometry> <mesh filename="fix7.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="fix7.dae"/> </geometry> </collision>
        <visual>   <geometry> <mesh filename="fix8.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="fix8.dae"/> </geometry> </collision>
        <visual>   <geometry> <mesh filename="fix9.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="fix9.dae"/> </geometry> </collision>
        <visual>   <geometry> <mesh filename="fix10.dae"/> </geometry> </visual>
        <collision><geometry> <mesh filename="fix10.dae"/> </geometry> </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="1.0"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
    </link>

    <link name="cutter_1_link">

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.2"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
    </link>

    <joint name="base_to_cutter_joint" type="revolute">
        <parent link="base_link"/>
        <child link="cutter_1_link"/>
        <origin xyz="-0.3 0 0.01" rpy="0 0 0"/> <axis xyz="0 1 0"/>               
        <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
    </joint>

    <link name="cutter_children_link">

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.3"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
    </link>

    <joint name="cutter_1_to_children" type="fixed">
        <parent link="cutter_1_link"/>
        <child link="cutter_children_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>


    <link name="taping_front_1_link">

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.2"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
    </link>

    <joint name="base_to_taping_front_joint" type="revolute">
        <parent link="base_link"/>
        <child link="taping_front_1_link"/>
        <origin xyz="-0.3 0 0.03" rpy="0 0 0"/> <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
    </joint>

    <link name="taping_front_children_link">

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.3"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
    </link>

    <joint name="taping_front_1_to_children" type="fixed">
        <parent link="taping_front_1_link"/>
        <child link="taping_front_children_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>


    <link name="taping_back_1_link">

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.2"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
    </link>

    <joint name="base_to_taping_back_joint" type="revolute">
        <parent link="base_link"/>
        <child link="taping_back_1_link"/>
        <origin xyz="0.0 0 0.03" rpy="0 0 0"/> <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
    </joint>

    <link name="taping_back_children_link">

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.3"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
    </link>

    <joint name="taping_back_1_to_children" type="fixed">
        <parent link="taping_back_1_link"/>
        <child link="taping_back_children_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

</robot>