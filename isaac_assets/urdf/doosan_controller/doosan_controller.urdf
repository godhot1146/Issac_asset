<?xml version="1.0"?>
<!--
  doosan_controller.urdf
  바탕화면 Doosan_Robotics_controller.step → 변환. 단일 바디(링크 1개). 로봇팔 컨트롤러(전장 박스).
  - 원본 STEP 단위 mm → 메쉬 좌표 자체를 m로 스케일 (scale="1 1 1")
  - 솔리드 69개(볼트/커넥터 등 디테일 다수)에 원본 BREP 스케일 변환이 곡면 일부에서 실패해
    mm 단위로 먼저 테셀레이션 후 정점만 스케일하는 방식으로 우회 변환.
  - 원래 Mesh.decimate로 4.6만개까지 단순화했었는데 모델이 깨져 보이는 문제가 있어서,
    단순화 없이 원본 테셀레이션(26만 3,544면) 그대로 사용함 — 렌더링 부하는 있지만 형상은 온전함.
  - 원점: 모델 자체 기준점 (중심/바닥 어디에도 안 맞음, x:-0.039~0.443, y:-0.203~0.028, z:-0.079~0.263)
  - 치수 0.482 x 0.231 x 0.342 m (삼각형 263,544면, 원본 그대로)
  - 시각(visual): 원본 메쉬(단순화 없음). 충돌(collision): 박스로 단순화(치수=메쉬 바운딩박스)
  - 정적 소품(스탠드 옆 바닥 거치)이므로 스폰 시 AssetOptions.fix_base_link=True 권장
-->
<robot name="doosan_controller">

  <material name="controller_gray"> <color rgba="0.30 0.31 0.33 1.0"/> </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0.2017 -0.0872 0.0919"/>
      <mass value="18.0"/>
      <!-- 박스 관성 (m=18, 0.482x0.231x0.342) -->
      <inertia ixx="0.2558" ixy="0" ixz="0" iyy="0.5242" iyz="0" izz="0.4285"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0"/>
      <geometry><mesh filename="meshes/doosan_controller.stl" scale="1 1 1"/></geometry>
      <material name="controller_gray"/>
    </visual>

    <collision>
      <origin xyz="0.2017 -0.0872 0.0919"/>
      <geometry><box size="0.482 0.231 0.342"/></geometry>
    </collision>
  </link>
</robot>
