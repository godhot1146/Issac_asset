<?xml version="1.0"?>
<!--
  air_compressor_v2.urdf
  바탕화면 air_compressor.step → 변환. 단일 바디(링크 1개).
  - 원본 STEP 단위 mm → 원본 BREP 스케일 변환이 일부 트림 커브에서 실패해
    (Geom_TrimmedCurve::parameters out of range) mm 단위로 먼저 테셀레이션 후
    정점만 m로 스케일하는 방식으로 우회 변환.
  - 원점: 모델 자체 기준점. XY는 거의 중심 정렬(x:-0.002~0.460, y:-0.157~0.155),
    Z는 바닥/중심 어디에도 안 맞음(z:-0.166~0.358)
  - 치수 0.4615 x 0.3126 x 0.5248 m (삼각형 8,670면)
  - 시각(visual): 원본 메쉬. 충돌(collision): 박스로 단순화(치수=메쉬 바운딩박스)
  - 정적 소품(스탠드 내부 거치)이므로 스폰 시 AssetOptions.fix_base_link=True 권장
-->
<robot name="air_compressor_v2">

  <material name="compressor_dark"> <color rgba="0.20 0.22 0.25 1.0"/> </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0.2293 -0.0009 0.0960"/>
      <mass value="15.0"/>
      <!-- 박스 관성 (m=15, 0.4615x0.3126x0.5248) -->
      <inertia ixx="0.4664" ixy="0" ixz="0" iyy="0.6105" iyz="0" izz="0.3884"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0"/>
      <geometry><mesh filename="meshes/air_compressor_v2.stl" scale="1 1 1"/></geometry>
      <material name="compressor_dark"/>
    </visual>

    <collision>
      <origin xyz="0.2293 -0.0009 0.0960"/>
      <geometry><box size="0.4615 0.3126 0.5248"/></geometry>
    </collision>
  </link>
</robot>
