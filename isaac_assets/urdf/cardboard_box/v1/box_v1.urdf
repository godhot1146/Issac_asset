<?xml version="1.0"?>
<robot name="box">

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="link_right">
    <visual>   <geometry> <mesh filename="box_base.dae"/> </geometry> </visual> 
    <collision><geometry> <mesh filename="box_base.dae"/> </geometry> </collision>
    <inertial> 
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/> 
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/> 
    </inertial>
  </link>

  <joint name="joint_base_to_right" type="fixed">
    <parent link="base_link"/>
    <child link="link_right"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="link_right_up">
    <visual>   <geometry> <mesh filename="box_right_up.dae"/> </geometry> </visual>
    <collision><geometry> <mesh filename="box_right_up.dae"/> </geometry> </collision>
    <inertial> <mass value="0.01"/> <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/> </inertial>
  </link>

  <joint name="joint_right_to_up" type="revolute">
    <parent link="link_right"/>
    <child link="link_right_up"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/> 
    <axis xyz="1 0 0"/> <limit lower="-6.28" upper="6.28" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="link_right_down">
    <visual>   <geometry> <mesh filename="box_right_down.dae"/> </geometry> </visual>
    <collision><geometry> <mesh filename="box_right_down.dae"/> </geometry> </collision>
    <inertial> <mass value="0.01"/> <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/> </inertial>
  </link>

  <joint name="joint_right_to_down" type="revolute">
    <parent link="link_right"/>
    <child link="link_right_down"/>
    <origin xyz="0 0 -0.15" rpy="0 0 0"/> 
    <axis xyz="1 0 0"/> <limit lower="-6.28" upper="6.28" effort="10.0" velocity="1.0"/>
  </joint>


  <link name="link_front">
    <visual>   <geometry> <mesh filename="box_front.dae"/> </geometry> </visual>
    <collision><geometry> <mesh filename="box_front.dae"/> </geometry> </collision>
    <inertial> <mass value="0.01"/> <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/> </inertial>
  </link>

  <joint name="joint_right_to_front" type="revolute">
    <parent link="link_right"/>
    <child link="link_front"/>
    <origin xyz="0.25 0.0025 0" rpy="0 0 1.5708"/> 
    <axis xyz="0 0 1"/> <limit lower="-6.28" upper="6.28" effort="10.0" velocity="1.0"/> 
  </joint>

  <link name="link_front_up">
    <visual>   <geometry> <mesh filename="box_front_up.dae"/> </geometry> </visual>
    <collision><geometry> <mesh filename="box_front_up.dae"/> </geometry> </collision>
    <inertial> <mass value="0.01"/> <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/> </inertial>
  </link>

  <joint name="joint_front_to_up" type="revolute">
    <parent link="link_front"/>
    <child link="link_front_up"/>
    <origin xyz="0 0.1475 0.145" rpy="0 0 0"/>
    <axis xyz="0 1 0"/> <limit lower="-6.28" upper="6.28" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="link_front_down">
    <visual>   <geometry> <mesh filename="box_front_down.dae"/> </geometry> </visual>
    <collision><geometry> <mesh filename="box_front_down.dae"/> </geometry> </collision>
    <inertial> <mass value="0.01"/> <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/> </inertial>
  </link>

  <joint name="joint_front_to_down" type="revolute">
    <parent link="link_front"/>
    <child link="link_front_down"/>
    <origin xyz="0 0.1475 -0.145" rpy="0 0 0"/>
    <axis xyz="0 1 0"/> <limit lower="-6.28" upper="6.28" effort="10.0" velocity="1.0"/>
  </joint>


  <link name="link_left">
    <visual>   <geometry> <mesh filename="box_left.dae"/> </geometry> </visual>
    <collision><geometry> <mesh filename="box_left.dae"/> </geometry> </collision>
    <inertial> <mass value="0.01"/> <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/> </inertial>
  </link>

  <joint name="joint_front_to_left" type="revolute">
    <parent link="link_front"/>
    <child link="link_left"/>
    <origin xyz="0 0.3 0" rpy="0 0 -1.5708"/> 
    <axis xyz="0 0 1"/> <limit lower="-6.28" upper="6.28" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="link_left_up">
    <visual>   <geometry> <mesh filename="box_left_up.dae"/> </geometry> </visual>
    <collision><geometry> <mesh filename="box_left_up.dae"/> </geometry> </collision>
    <inertial> <mass value="0.01"/> <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/> </inertial>
  </link>

  <joint name="joint_left_to_up" type="revolute">
    <parent link="link_left"/>
    <child link="link_left_up"/>
    <origin xyz="-0.2525 0 0.15" rpy="0 0 0"/>
    <axis xyz="1 0 0"/> <limit lower="-6.28" upper="6.28" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="link_left_down">
    <visual>   <geometry> <mesh filename="box_left_down.dae"/> </geometry> </visual>
    <collision><geometry> <mesh filename="box_left_down.dae"/> </geometry> </collision>
    <inertial> <mass value="0.01"/> <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/> </inertial>
  </link>

  <joint name="joint_left_to_down" type="revolute">
    <parent link="link_left"/>
    <child link="link_left_down"/>
    <origin xyz="-0.2525 0 -0.15" rpy="0 0 0"/>
    <axis xyz="1 0 0"/> <limit lower="-6.28" upper="6.28" effort="10.0" velocity="1.0"/>
  </joint>


  <link name="link_back">
    <visual>   <geometry> <mesh filename="box_back.dae"/> </geometry> </visual>
    <collision><geometry> <mesh filename="box_back.dae"/> </geometry> </collision>
    <inertial> <mass value="0.01"/> <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/> </inertial>
  </link>

  <joint name="joint_right_to_back" type="revolute">
    <parent link="link_right"/>
    <child link="link_back"/>
    <origin xyz="-0.25 0.0025 0" rpy="0 0 1.5708"/> 
    <axis xyz="0 0 1"/> <limit lower="-6.28" upper="6.28" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="link_back_up">
    <visual>   <geometry> <mesh filename="box_back_up.dae"/> </geometry> </visual>
    <collision><geometry> <mesh filename="box_back_up.dae"/> </geometry> </collision>
    <inertial> <mass value="0.01"/> <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/> </inertial>
  </link>

  <joint name="joint_back_to_up" type="revolute">
    <parent link="link_back"/>
    <child link="link_back_up"/>
    <origin xyz="0 0.1475 0.145" rpy="0 0 0"/>
    <axis xyz="0 1 0"/> <limit lower="-6.28" upper="6.28" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="link_back_down">
    <visual>   <geometry> <mesh filename="box_back_down.dae"/> </geometry> </visual>
    <collision><geometry> <mesh filename="box_back_down.dae"/> </geometry> </collision>
    <inertial> <mass value="0.01"/> <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/> </inertial>
  </link>

  <joint name="joint_back_to_down" type="revolute">
    <parent link="link_back"/>
    <child link="link_back_down"/>
    <origin xyz="0 0.1475 -0.145" rpy="0 0 0"/>
    <axis xyz="0 1 0"/> <limit lower="-6.28" upper="6.28" effort="10.0" velocity="1.0"/>
  </joint>

</robot>