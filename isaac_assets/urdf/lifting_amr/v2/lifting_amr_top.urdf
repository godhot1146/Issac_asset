<?xml version="1.0"?>
<robot name="tote">

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
  </link>

  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="mast_link">

    <visual> <geometry> <mesh filename="mast/mast_beam_up.dae"/> </geometry> </visual>
    <visual> <geometry> <mesh filename="mast/mast_beam_left.dae"/> </geometry> </visual>
    <visual> <geometry> <mesh filename="mast/mast_beam_right.dae"/> </geometry> </visual>    

    <visual> <origin xyz="0 0 0.0" rpy="0 0 0"/> <geometry> <mesh filename="mast/mast_tray_base.dae"/> </geometry> </visual>    
    <visual> <origin xyz="0 0 0.0" rpy="0 0 0"/> <geometry> <mesh filename="mast/mast_tray_back.dae"/> </geometry> </visual>    
    <visual> <origin xyz="0 0 0.0" rpy="0 0 0"/> <geometry> <mesh filename="mast/mast_tray_left.dae"/> </geometry> </visual>    
    <visual> <origin xyz="0 0 0.0" rpy="0 0 0"/> <geometry> <mesh filename="mast/mast_tray_right.dae"/> </geometry> </visual>    
    <visual> <origin xyz="0 0 0.0" rpy="0 0 0"/> <geometry> <mesh filename="mast/mast_tray_support_base.dae"/> </geometry> </visual>    
    <visual> <origin xyz="0 0 0.0" rpy="0 0 0"/> <geometry> <mesh filename="mast/mast_tray_support_left.dae"/> </geometry> </visual>    
    <visual> <origin xyz="0 0 0.0" rpy="0 0 0"/> <geometry> <mesh filename="mast/mast_tray_support_right.dae"/> </geometry> </visual>        

    <visual> <origin xyz="0 0 0.5" rpy="0 0 0"/> <geometry> <mesh filename="mast/mast_tray_base.dae"/> </geometry> </visual>    
    <visual> <origin xyz="0 0 0.5" rpy="0 0 0"/> <geometry> <mesh filename="mast/mast_tray_back.dae"/> </geometry> </visual>    
    <visual> <origin xyz="0 0 0.5" rpy="0 0 0"/> <geometry> <mesh filename="mast/mast_tray_left.dae"/> </geometry> </visual>    
    <visual> <origin xyz="0 0 0.5" rpy="0 0 0"/> <geometry> <mesh filename="mast/mast_tray_right.dae"/> </geometry> </visual>    
    <visual> <origin xyz="0 0 0.5" rpy="0 0 0"/> <geometry> <mesh filename="mast/mast_tray_support_base.dae"/> </geometry> </visual>    
