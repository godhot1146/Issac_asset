<?xml version="1.0"?>
<!--
  a0509_stand.urdf
  A0509 전용 로봇 스탠드 (실측 CAD). 단일 바디(링크 1개).
  - 원본: assets/A0509_Stand.step (STEP → STL 변환, mm 단위 → m 스케일, 원점이 상판(z=0)
    기준 아래로 뻗어있던 것을 바닥(z=0)~상판(z=0.81) 기준으로 변환)
  - 시각(visual): meshes/a0509_stand.stl
  - 충돌(collision): 박스로 단순화. 삼각형 면적 분석 결과 상판(810mm)이 전체 발자국
    면적(5397.5cm^2 ≈ 60x90cm)을 그대로 유지하는 진짜 상판이라 바운딩박스 그대로 사용
    (work_table/grill_rack과 달리 얇은 립/핀 문제 없음, 확인 완료).
  - 치수 0.6(x) x 0.9(y) x 0.81(z) m, x/y는 중심 정렬, z는 바닥(0~0.81).
  - 로봇은 상판(z=0.81)에 장착.
-->
<robot name="a0509_stand">

  <material name="stand_gray"> <color rgba="0.55 0.57 0.60 1.0"/> </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.405"/>
      <mass value="35.0"/>
      <!-- 박스 관성 (m=35, 0.6x0.9x0.81) -->
      <inertia ixx="2.68" ixy="0" ixz="0" iyy="1.98" iyz="0" izz="2.66"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0"/>
      <geometry><mesh filename="meshes/a0509_stand.stl" scale="1 1 1"/></geometry>
      <material name="stand_gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.405"/>
      <geometry><box size="0.6 0.9 0.81"/></geometry>
    </collision>
  </link>
</robot>
